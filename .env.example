# Environment variables — copy to .env and fill in. NEVER commit .env.
# API keys live server-side only. The browser never sees these values.
# Every value below is a PLACEHOLDER — no real keys live in this repo.

# fal.ai API key — required for real transforms (FLUX.2 Pro Edit).
FAL_KEY=

# Optional: vision provider key for the interpretation step.
# If unset, server.js uses a clearly-marked generic fallback prompt
# and the server still starts. See interpretDrawing() in server.js.
VISION_API_KEY=
VISION_PROVIDER=

# Public base URL of the deployed app (used for Stripe success/cancel
# links and magic-link URLs). Local default: http://localhost:3000
BASE_URL=

# --- Stripe (TEST MODE ONLY in this build) -------------------------------
# Create the products/prices in the Stripe TEST dashboard first, then
# paste the test ids here. Live keys are NOT wired — do not put a live
# secret key (sk_live_...) in here; the code does not distinguish, so
# live mode needs a real Stripe account + a review before enabling.
# See docs/deploy.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_FAMILY_YEARLY=
STRIPE_PRICE_MAGIC_PACK=

# --- Cost dashboard (admin only) -----------------------------------------
# Token that unlocks GET /api/admin/dashboard (header x-admin-token).
# If unset, the dashboard returns 503 (not configured).
ADMIN_TOKEN=
# Daily AI-spend level (USD) that flips the dashboard alert flag.
DAILY_SPEND_ALERT_USD=5
# Kill switch: set to 1 to pause ALL transforms (503 "disabled").
KILL_SWITCH=0

# --- Safety & compliance (Batch 3) ---------------------------------------
# Title/phrase blocklist: extra terms, comma-separated, no restart needed.
# See lib/blocklist.js. Leave blank to use the built-in starter list.
BLOCKLIST_EXTRA_TERMS=
# Output-image safety check: stub (default — clearly-marked stub, no
# provider call) | off (debug only, never production) | live (real
# provider — NOT wired yet, fails closed until it is). See lib/output-safety.js.
OUTPUT_SAFETY_CHECK=stub
# Audit log: optional JSONL file path, e.g. data/audit.jsonl. Events carry
# a hashed account id only — never email, titles, or images. See docs/audit-log-schema.md.
AUDIT_LOG_FILE=
# Salt for hashing account ids in audit events. Set a long random value
# in production; the built-in default is dev-only. See lib/audit.js.
AUDIT_HASH_SALT=
# Auto-purge window (days) for anonymous (no-parent-account) gallery works.
# Parent-account works are kept until the parent deletes them. See docs/data-retention.md.
GALLERY_RETENTION_DAYS=90

# --- Gallery storage ------------------------------------------------------
# local (default, dev) or s3 (production stub — see README).
STORAGE_BACKEND=local
# S3-compatible object storage for production (env-configured only).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Structured logging & error monitoring (Batch 5) ---------------------
# JSON-lines logs: debug/info (default)/warn/error. LOG_FILE and
# ERROR_LOG_FILE are optional JSONL paths (e.g. data/server.jsonl,
# data/errors.jsonl). Logs never contain keys, emails, titles, phrases,
# image URLs or drawing contents — see lib/logger.js / lib/errors.js.
LOG_LEVEL=info
LOG_FILE=
ERROR_LOG_FILE=
